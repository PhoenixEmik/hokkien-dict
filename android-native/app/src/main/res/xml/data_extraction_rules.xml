<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="dictionary.sqlite" />
        <exclude domain="database" path="dictionary.sqlite-shm" />
        <exclude domain="database" path="dictionary.sqlite-wal" />
        <exclude domain="file" path="dictionary_source" />
        <exclude domain="file" path="dictionary_source/" />
        <exclude domain="file" path="offline_audio" />
        <exclude domain="file" path="offline_audio/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="dictionary.sqlite" />
        <exclude domain="database" path="dictionary.sqlite-shm" />
        <exclude domain="database" path="dictionary.sqlite-wal" />
        <exclude domain="file" path="dictionary_source" />
        <exclude domain="file" path="dictionary_source/" />
        <exclude domain="file" path="offline_audio" />
        <exclude domain="file" path="offline_audio/" />
    </device-transfer>
</data-extraction-rules>
